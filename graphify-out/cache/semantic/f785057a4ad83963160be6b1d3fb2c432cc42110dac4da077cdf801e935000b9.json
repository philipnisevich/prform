{"nodes": [{"id": "prd_prd_md", "label": "PRD.md", "file_type": "document", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_problem_statement", "label": "Problem statement (PRD \u00a71)", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managers evaluate engineers on system-of-record credit (commits, PRs, tickets closed), so high-leverage but uncredited work \u2014 unblocking a teammate, catching a bug in review, triaging an incident \u2014 is invisible to every dashboard and invisible at review time."}, {"id": "prd_thesis", "label": "MVP thesis: degradation must be provable", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricting the tool to one connector must make the output become a confident, wrong performance review rather than going blank, and the MVP must make that provable, not merely observable \u2014 the falsifiability bar the whole build is designed around."}, {"id": "prd_users_visibility", "label": "Users & visibility (PRD \u00a73)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engineer sees own ghost work, manager sees direct reports only, nobody sees the whole org \u2014 ranking everyone is the failure mode, not the feature; enforced by RLS, not by UI."}, {"id": "prd_p0_scope", "label": "P0 scope \u2014 ships or no demo", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_p1_scope", "label": "P1 scope \u2014 ships if on schedule", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_p2_scope", "label": "P2 scope \u2014 nice, cut without regret", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_non_goals", "label": "Explicit non-goals", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No dashboard, no auth/UI polish, no fine-tuning, no score presented as objective truth, no write-back to source systems, no historical trending, no multi-org tenancy."}, {"id": "prd_success_criteria", "label": "Success criteria (PRD \u00a75)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five pass/fail criteria; criteria 3 (Slack-only run yields 0 confirmed findings, no redeploy) and 4 (the view definition itself shows the enabled_sources gate) together are described as the actual submission \u2014 everything else is support."}, {"id": "prd_architecture_diagram", "label": "Architecture (PRD \u00a76)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_hydradb", "label": "HydraDB", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns cross-source identity resolution and raw event/ticket pulls from Slack/GitHub/Linear; confirmation is impossible without knowing that a Slack handle and a Linear assignee are the same or different people, and nothing else in the stack can produce that resolution."}, {"id": "prd_pipeshift", "label": "Pipeshift", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classifies messages (unblock/review/triage/decision/noise) with strict JSON output, turning 'this message mentions ENG-412' into 'this message unblocked someone on ENG-412'; rule (a) confirms the link, Pipeshift characterizes the help."}, {"id": "prd_rocketride", "label": "RocketRide", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns the public endpoint, stage orchestration, bounded-concurrency LLM fan-out with per-message retry on malformed JSON, and checkpoint/resume so a crashed run resumes rather than restarts \u2014 its role was deliberately restored after moving attribution logic into Postgres thinned it."}, {"id": "prd_insforge_sponsor_role", "label": "InsForge's role in the architecture", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns the attribution engine, degradation guarantee, classification cache, access control, and snapshots \u2014 'the detector itself,' and also what makes the live re-run physically possible during a demo."}, {"id": "prd_api_request_contract", "label": "POST /run request contract", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sources is the toggle; changing it requires no deploy. replay_snapshot reruns from a cached HydraDB pull for offline determinism."}, {"id": "prd_api_response_contract", "label": "POST /run response contract", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_degraded_block", "label": "degraded response block", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declares which attribution rules could not run and why, framed explicitly as a product feature rather than debug output \u2014 a tool that reports what it cannot see is the opposite of the dashboards being criticized."}, {"id": "prd_access_control", "label": "Access control (PRD \u00a78)", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS is on for person, attribution, and source_event; an engineer sees rows where person_id matches the current auth.uid()'s person, a manager sees direct reports via a SECURITY DEFINER helper chosen to avoid RLS recursion, and no policy grants org-wide read \u2014 that absence is the point."}, {"id": "prd_reports_to_function", "label": "public.reports_to(uuid)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SECURITY DEFINER helper used to determine manager-of-reports visibility without RLS recursion."}, {"id": "prd_degradation_mechanism", "label": "Degradation mechanism (PRD \u00a78, SQL example)", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every read in the attribution path goes through a view like visible_ticket_state (security_invoker = true) gated on the run's enabled_sources; confirm_attributions() joins only against the visible_* views, never the base tables, so there is no code path that could produce a confirmation once a source is disabled."}, {"id": "prd_ranking_formula", "label": "Ranking formula (PRD \u00a79)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "visible = 1.0*prs + 1.0*tickets_closed + 0.3*commits; invisible = 1.0*confirmed_unblocks + 0.7*reviews + 0.5*triage; divergence = invisible / (visible + invisible)."}, {"id": "prd_evidence_floor", "label": "Evidence floor", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A person is not rankable below 2 confirmed attributions; without this correction a new hire with two Slack messages and zero PRs scores 1.0 divergence and tops the ranking, surfacing new hires and managers rather than ghost work."}, {"id": "prd_never_render_number", "label": "Never render the divergence number", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "divergence is kept as an internal sort key only and never appears in the response, report, or on screen, because shipping a visible score contradicts the pitch's promise that the result isn't a score and risks being screenshotted into a real performance review."}, {"id": "prd_build_schedule", "label": "Build schedule (PRD \u00a710)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_fallback_tiers", "label": "Fallback tiers (PRD \u00a710)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_risks_table", "label": "Risks (PRD \u00a711)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_gmail_source", "label": "Gmail source (PRD)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expected to contribute nothing; stays in the sources array because four toggleable sources makes the degradation demo richer, but no logic gets built for it."}, {"id": "prd_demo_script", "label": "Demo script (PRD \u00a712)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_open_questions", "label": "Open questions (PRD \u00a713)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "prd_prd_md", "target": "pivot_pivot_md", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_prd_md", "target": "pivot_witness", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_prd_md", "target": "pivot_ghost_work", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_prd_md", "target": "pivot_person_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_prd_md", "target": "pivot_identity_claim_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_prd_md", "target": "pivot_source_event_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_prd_md", "target": "pivot_ticket_state_table", "relation": "references", "confidence"