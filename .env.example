# InsForge — already provisioned, see .insforge/project.json
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_URL=
INSFORGE_API_KEY=

# HydraDB — sign up at https://app.hydradb.com for an API key.
# HYDRA_DB_DATABASE is a name you choose (e.g. "witness"); hydradb/bootstrap.ts
# provisions it on first run. HydraDB has no connector/sync system — it's a
# knowledge/memory store we push Slack messages into ourselves.
HYDRA_DB_API_KEY=
HYDRA_DB_DATABASE=witness

# Slack/GitHub/Linear are pulled directly from their own APIs (see hydradb/sync.ts).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=
LINEAR_API_KEY=
LINEAR_TEAM_KEY=

# RocketRide — either request Cloud access at https://cloud.rocketride.ai
# (ROCKETRIDE_URI=https://api.rocketride.ai) or self-host (ROCKETRIDE_URI
# points at your own deployment). See rocketride/README.md.
ROCKETRIDE_URI=
ROCKETRIDE_AUTH=
